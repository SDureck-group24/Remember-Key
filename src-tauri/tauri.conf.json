{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remember Key",
  "version": "0.4.0",
  "identifier": "com.rememberkey.app",
  "build": {
    "beforeDevCommand": "npm run build:bridge && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bridge && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Remember Key",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/remember-key-mcp", "binaries/remember-key-browser"],
    "resources": { "../extension/": "extension/" },
    "publisher": "Simon Dureck",
    "copyright": "© 2026 Simon Dureck",
    "category": "Utility",
    "shortDescription": "Lokaler Passwort- und Login-Manager",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
