{
  "manifest_version": 3,
  "name": "Remember Key",
  "version": "0.2.0",
  "description": "Füllt Logins für KI-Assistenten aus – erst nach deiner Bestätigung in Remember Key. Die KI sieht das Passwort nie.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "remember-key@rememberkey.app",
      "strict_min_version": "128.0"
    }
  }
}
